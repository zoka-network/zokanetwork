# Reference unit file for a unified zoka-node.service.
# The deploy-mainnet.yml workflow writes this file to /etc/systemd/system/ on
# each server with the correct ExecStart flags for that server's role.
#
# Role is differentiated by flags, not by service name:
#   seed/bootstrap  — no --no-mine required; no --address needed for mining
#   full/rpc        — --no-mine, no miner address

[Unit]
Description=Zoka Node (Zenith mainnet)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/data/zoka
# Role-specific ExecStart is written by the deploy workflow.
# All nodes share the network config and the same environment variables.
ExecStart=/usr/local/bin/zoka fullnode \
  --network mainnet \
  --network-config /opt/zoka/mainnet-network.v1.json \
  --db /data/zoka/blockchain.db \
  --listen /ip4/0.0.0.0/tcp/28080 \
  --no-mine \
  --sync-warmup-secs 30 \
  --sync-rebroadcast-recent-blocks 32 \
  --allow-isolated-start \
  --password-env ZOKA_NODE_PASSWORD
Environment=RUST_LOG=info
Environment=ZOKA_HOME=/data/zoka
Environment=ZOKA_TRUSTED_SETUP_DIR=/opt/zoka/trusted-setup
Environment=ZOKA_API_BIND=0.0.0.0:3000
Environment=ZOKA_API_RATE_LIMIT=180
Environment=ZOKA_API_READ_RATE_LIMIT=5000
Environment=ZOKA_API_TX_RATE_LIMIT=120
Environment=ZOKA_API_MAX_BODY_BYTES=1048576
Environment=ZOKA_API_ENABLE_BLOCK_SUBMIT=true
Restart=on-failure
RestartSec=10s
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
