{
  "schema": "zoka-testnet-network-v1",
  "status": "public-testnet-v0.1",
  "chain_id": "zoka-testnet-v1",
  "protocol_freeze_id": "/zoka/1.0.0",
  "transport_policy": {
    "anonymous_transport_preferred": true,
    "clearnet_requires_explicit_operator_choice": false,
    "supported": [
      "tor",
      "i2p",
      "tcp"
    ]
  },
  "seed_nodes": [
    {
      "label": "seed1",
      "operator": "zoka-core",
      "region": "community",
      "multiaddr": "/dns4/seed1.zoka.network/tcp/28080",
      "onion": "/onion3/d5pk3nhesk5wlvz4f5unbhcozxgtj7u6mhagauyprjrxndzpwbaoeiid:28080",
      "i2p": null,
      "iroh": "ca7721e29d60af28dda8406191f6d7a98e146b95cd456392d0c2d2b996639f99",
      "role": "seed",
      "status": "active",
      "note": "Same operator and same host as the mainnet seed. The onion service and iroh endpoint belong to the machine, not to the chain, so they serve testnet too — but only one network at a time, since both bind port 28080."
    }
  ],
  "public_rpc": [],
  "snapshot_signers": [],
  "notes": [
    "Public testnet configuration for the testnet-v0.1.0 release line.",
    "Testnet uses the public ZOKA blockchain logic and RandomX PoW, same as mainnet.",
    "Bugs found on testnet must be fixed in shared code, not testnet-only blockchain paths.",
    "No recovery/checkpoint gate here on purpose: mainnet quarantines a node whose history does not match a signed checkpoint, which is exactly the safety net a testnet must not have if it is going to be reset and rebuilt freely."
  ],
  "minimum_client_version": "1.9.0",
  "desktop": {
    "local_rpc_url": "http://127.0.0.1:3000"
  },
  "mining": {
    "algorithm": "randomx",
    "open_participation": true,
    "reward_routing": "direct-to-miner",
    "note": "Same PoW as mainnet: canonical_algorithm_for() maps both chain ids to RandomX. What differs is the starting difficulty, which begins at the 12-bit floor, so early blocks land in seconds.",
    "min_peers_to_mine": 1,
    "example_command": "zoka fullnode --network testnet --network-config testnet-network.v1.json --mine-interval-secs 30 --mine-blocks 1 --min-mine-peers 1 --address <your-zka1-address> --password <your-password>"
  },
  "joining": {
    "full_node": "zoka fullnode --network testnet --network-config testnet-network.v1.json --no-mine --allow-isolated-start --password <your-password>",
    "miner": "zoka fullnode --network testnet --network-config testnet-network.v1.json --mine-interval-secs 30 --mine-blocks 1 --min-mine-peers 1 --address <your-zka1-address> --password <your-password>",
    "note": "Testnet coins carry no value and the chain may be reset without notice. Wallets, chain data and offers live under .zoka/testnet, separate from mainnet."
  },
