{
  "schema": "zoka-mainnet-network-v1",
  "status": "active",
  "chain_id": "zoka-mainnet-zenith-v1",
  "protocol_freeze_id": "/zoka/1.6.0-mainnet-zenith",
  "minimum_client_version": "1.6.0",
  "transport_policy": {
    "anonymous_transport_preferred": false,
    "clearnet_requires_explicit_operator_choice": false,
    "supported": ["tcp"]
  },
  "seed_nodes": [
    {
      "label": "seed1",
      "operator": "zoka-core",
      "region": "community",
      "multiaddr": "/dns4/seed1.zoka.network/tcp/28080",
      "onion": "/onion3/d5pk3nhesk5wlvz4f5unbhcozxgtj7u6mhagauyprjrxndzpwbaoeiid:28080",
      "i2p": null,
      "role": "seed",
      "status": "active",
      "note": "Primary bootstrap, hybrid: reachable over clearnet TCP (DNS, needs the operator's port 28080 open) and over Tor v3 onion (needs no open port; nodes started with --tor-proxy dial it). Nodes without a Tor proxy skip the onion and use the TCP address."
    },
    {
      "label": "seed2",
      "operator": "zoka-core",
      "region": "community",
      "multiaddr": "/dns4/seed2.zoka.network/tcp/28080",
      "onion": null,
      "i2p": null,
      "role": "seed",
      "status": "active",
      "note": "Secondary bootstrap - fallback peer discovery if seed1 is unreachable."
    }
  ],
  "public_rpc": [
    {
      "label": "rpc1",
      "operator": "zoka-core",
      "region": "community",
      "url": "http://rpc.zoka.network:3000",
      "onion": null,
      "i2p": null,
      "status": "active",
      "logging_policy": "no-wallet-secrets-no-private-keys"
    }
  ],
  "desktop": {
    "local_rpc_url": "http://127.0.0.1:3000"
  },
  "mining": {
    "algorithm": "randomx",
    "open_participation": true,
    "reward_routing": "direct-to-miner",
    "note": "Any node can mine. Set --address <your-zka1-wallet> to receive block rewards directly.",
    "min_peers_to_mine": 1,
    "example_command": "zoka fullnode --network mainnet --network-config mainnet-network.v1.json --mine-interval-secs 30 --mine-blocks 1 --min-mine-peers 1 --address <your-zka1-address> --password <your-password>"
  },
  "joining": {
    "full_node": "zoka fullnode --network mainnet --network-config mainnet-network.v1.json --no-mine --allow-isolated-start --password <your-password>",
    "miner": "zoka fullnode --network mainnet --network-config mainnet-network.v1.json --mine-interval-secs 30 --mine-blocks 1 --min-mine-peers 1 --address <your-zka1-address> --password <your-password>",
    "note": "The node auto-discovers peers from the seed nodes. After the first successful join, the persistent peer store lets the node reconnect to the mesh even if every seed is down. Block rewards go directly to your wallet by protocol - no pool or intermediary."
  },
